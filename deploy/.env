COMPOSE_FILE=docker-compose.yml:mongo/docker-compose.yml:phoenix/docker-compose.yml:rails/docker-compose.yml
COMPOSE_PROJECT_NAME=deploy

# TODO: Configure the deployment
PROJECT_NAME=mdcs
IMAGE_NAME=mdcs
IMAGE_VERSION=latest
HOSTNAME=10.0.1.50
SERVER_URI=http://10.0.1.50
ALLOWED_HOSTS=*
SERVER_NAME=MDCS
WEB_SERVER=uwsgi
SERVER_CONF=default
SETTINGS=test_settings

# TODO: Set values for the databases configuration and credentials
MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASS=something
MONGO_USER=cdcs_user
MONGO_PASS=something
MONGO_DB=cdcs
POSTGRES_USER=cdcs_user
POSTGRES_PASS=something
POSTGRES_DB=cdcs
REDIS_PASS=something
DJANGO_SECRET_KEY=something

# TODO: Set versions for the components of the CDCS stack
MONGO_VERSION=7.0
REDIS_VERSION=7
POSTGRES_VERSION=16
NGINX_VERSION=1.27

# TODO: Set port mapping
NGINX_PORT_80=80
NGINX_PORT_443=443
PHOENIX_PORT=4000
PHOENIX_PORT_EXPOSE=4000
PHOENIX_HOST=phoenix.local
PHOENIX_POOL_SIZE=10
PHOENIX_DB_SSL=false
PHOENIX_SECRET_KEY_BASE=replace-me
PHOENIX_IMAGE_NAME=phoenix_app
PHOENIX_IMAGE_VERSION=latest
RAILS_IMAGE_NAME=rails_app
RAILS_IMAGE_VERSION=latest
RAILS_PORT=3000
RAILS_PORT_EXPOSE=3000
RAILS_HOST=rails.local
RAILS_FORCE_SSL=false
RAILS_MAX_THREADS=5
RAILS_MIN_THREADS=5
RAILS_WEB_CONCURRENCY=0
RAILS_MASTER_KEY=replace-me
