COMPOSE_FILE=docker-compose.yml:mongo/docker-compose.yml
COMPOSE_PROJECT_NAME=deploy

# TODO: Configure the deployment
PROJECT_NAME=mdcs
IMAGE_NAME=mdcs
IMAGE_VERSION=latest
HOSTNAME=127.0.0.1
SERVER_URI=http://127.0.0.1
# ALLOWED_HOSTS=10.0.1.50
ALLOWED_HOSTS=*
SERVER_NAME=MDCS
WEB_SERVER=uwsgi
SERVER_CONF=default
# SETTINGS=settings
SETTINGS=test_settings

# TODO: Set values for the databases configuration and credentials
MONGO_ADMIN_USER=mongoadmin
MONGO_ADMIN_PASS=mongopassword
MONGO_USER=mongouser
MONGO_PASS=mongopassword
MONGO_DB=cdcs_development
POSTGRES_USER=postgres
POSTGRES_PASS=postgres
POSTGRES_DB=cdcs_development
REDIS_PASS=something
DJANGO_SECRET_KEY=something

# TODO: Set versions for the components of the CDCS stack
MONGO_VERSION=7.0
REDIS_VERSION=7
POSTGRES_VERSION=16
NGINX_VERSION=1.27

# TODO: Set port mapping
NGINX_PORT_80=80
NGINX_PORT_443=443
